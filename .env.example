APP_NAME=LearnOS
APP_VERSION=0.1.0
APP_ENV=production
DEMO_SEED_ENABLED=false
# 容器内部监听端口；宿主机通过 APP_PORT 暴露。
APP_ADDR=:8080
APP_DATA_DIR=/app/data
DATA_HOST_DIR=./data/prod
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=20
BACKUP_HOST_DIR=./backups
# 直接通过服务器 IP 访问时使用 0.0.0.0；仅经 Caddy 访问时可改为 127.0.0.1。
APP_BIND_HOST=0.0.0.0
# 宿主机端口；容器内部仍映射到 8080。
APP_PORT=8888

# 生产环境域名，例如 learn.example.com。
APP_DOMAIN=learn.example.com

# 首次启动时创建管理员。默认示例密码为 change-me，部署前必须修改；之后管理员可在页面添加普通用户。
APP_USERNAME=admin
APP_PASSWORD_HASH='$2y$12$UX/AaWiy1a2gIVI8T7.SIe3hfh9Yt7/JzFcHvq/UxmLz/B3QeZPL.'

AI_TIMEOUT_SECONDS=45
AI_CHALLENGE_GENERATION_TIMEOUT_SECONDS=60
AI_CURRICULUM_DRAFT_TIMEOUT_SECONDS=60
AI_SOURCE_CREDIBILITY_TIMEOUT_SECONDS=45
AI_DOMAIN_SKELETON_TIMEOUT_SECONDS=120
AI_DOMAIN_STARTER_BLUEPRINT_TIMEOUT_SECONDS=60
AI_DOMAIN_INITIAL_WORLD_TIMEOUT_SECONDS=180
