# Export in the shell before running the Agent or installing its LaunchAgent.
LIFEOS_URL=https://lifeos.example.com
# For a local server or an SSH tunnel, use a loopback address.
# LIFEOS_URL=http://localhost:18888

# Explicitly include R18 in the Jellyfin sync allowlist. Default: false.
# JELLYFIN_INCLUDE_R18=true
